// Paste into https://dbdiagram.io to edit the ERD interactively (25 tables)
Table roles {
  role_id int [pk]
  role_name varchar [unique]
}

Table users {
  user_id int [pk]
  role_id int [ref: > roles.role_id]
  full_name varchar
  email varchar [unique]
  is_locked boolean
}

Table customers {
  customer_id int [pk]
  customer_name varchar
  tax_id varchar [unique]
  payment_term varchar
  credit_limit decimal
  assigned_sales_id int [ref: > users.user_id]
}

Table products {
  product_id int [pk]
  sku varchar [unique]
  product_name varchar
  default_price decimal
}

Table price_lists {
  price_list_id int [pk]
  customer_id int [ref: > customers.customer_id]
  product_id int [ref: > products.product_id]
  special_price decimal
}

Table stock_levels {
  product_id int [pk, ref: - products.product_id]
  on_hand_qty int
  reserved_qty int
  reorder_point int
  version int
}

Table orders {
  order_id int [pk]
  customer_id int [ref: > customers.customer_id]
  sales_user_id int [ref: > users.user_id]
  status varchar
  total_amount decimal
  confirmed_at datetime
}

Table order_lines {
  order_line_id int [pk]
  order_id int [ref: > orders.order_id]
  product_id int [ref: > products.product_id]
  quantity int
  shipped_qty int
  unit_price decimal
}

Table stock_reservations {
  reservation_id int [pk]
  order_line_id int [ref: > order_lines.order_line_id]
  product_id int [ref: > products.product_id]
  reserved_qty int
  status varchar
}

Table stock_movements {
  movement_id bigint [pk]
  product_id int [ref: > products.product_id]
  movement_type varchar
  quantity int
  created_by int [ref: > users.user_id]
}

Table order_approvals {
  approval_id int [pk]
  order_id int [ref: > orders.order_id]
  approval_reason varchar
  approver_id int [ref: > users.user_id]
  decision varchar
}

Table shipments {
  shipment_id int [pk]
  order_id int [ref: > orders.order_id]
  status varchar
  shipped_at datetime
}

Table shipment_lines {
  shipment_line_id int [pk]
  shipment_id int [ref: > shipments.shipment_id]
  order_line_id int [ref: > order_lines.order_line_id]
  shipped_qty int
}

Table returns {
  return_id int [pk]
  order_line_id int [ref: > order_lines.order_line_id]
  return_qty int
  reason varchar
  restock boolean
}

Table invoices {
  invoice_id int [pk]
  order_id int [ref: > orders.order_id]
  shipment_id int [ref: - shipments.shipment_id]
  due_date date
  total_amount decimal
  paid_amount decimal
  payment_status varchar
  is_locked boolean
}

Table invoice_lines {
  invoice_line_id int [pk]
  invoice_id int [ref: > invoices.invoice_id]
  shipment_line_id int [ref: > shipment_lines.shipment_line_id]
  quantity int
  line_total decimal
}

Table payments {
  payment_id int [pk]
  invoice_id int [ref: > invoices.invoice_id]
  amount decimal
  method varchar
  payment_date date
}

Table credit_notes {
  credit_note_id int [pk]
  invoice_id int [ref: > invoices.invoice_id]
  return_id int [ref: - returns.return_id]
  amount decimal
}

Table suppliers {
  supplier_id int [pk]
  supplier_name varchar
  lead_time_days int
}

Table purchase_requests {
  request_id int [pk]
  product_id int [ref: > products.product_id]
  suggested_qty int
  status varchar
}

Table purchase_orders {
  po_id int [pk]
  supplier_id int [ref: > suppliers.supplier_id]
  request_id int [ref: - purchase_requests.request_id]
  status varchar
}

Table po_lines {
  po_line_id int [pk]
  po_id int [ref: > purchase_orders.po_id]
  product_id int [ref: > products.product_id]
  ordered_qty int
  received_qty int
}

Table cycle_counts {
  count_id int [pk]
  product_id int [ref: > products.product_id]
  system_qty int
  counted_qty int
  counted_by int [ref: > users.user_id]
}

Table audit_log {
  audit_id bigint [pk]
  user_id int [ref: > users.user_id]
  entity_type varchar
  entity_id int
  action varchar
  created_at datetime
}

Table notifications {
  notification_id int [pk]
  recipient_role_id int [ref: > roles.role_id]
  type varchar
  is_read boolean
}
